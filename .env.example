POSTGRES_DB=churn_intelligence
POSTGRES_USER=matrisk
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
APP_PORT=8501
API_PORT=8000

# Optional: path inside app container to a trusted PEM CA bundle for TLS-inspecting proxies.
# Place the file at ./certs/custom-ca.pem and leave this default unchanged, or set a different container path.
MATRISK_CA_BUNDLE=
